{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "oc-plugin-llm-pricing",
  "version": "2.0.0",
  "description": "OpenCode plugin — LLM pricing, context windows, and features for your last 3 models per agent mode",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "llm",
    "pricing"
  ],
  "license": "MIT",
  "files": [
    "server.ts",
    "tui.tsx",
    "src"
  ],
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./tui.tsx"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@opencode/plugin": "^2.2.5",
    "@opencode/theme": "^2.2.5",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p __tests__/tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "engines": {
    "opencode": ">=2.2.0"
  }
}
